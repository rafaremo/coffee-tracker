{
  "name": "coffee-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import remix/node-tsx server.ts",
    "start": "node --env-file-if-exists=.env --import remix/node-tsx server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --import remix/node-tsx --test tests/*.test.ts",
    "mcp": "node --env-file-if-exists=.env --import remix/node-tsx mcp-stdio.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "express": "^5.1.0",
    "remix": "^3.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
