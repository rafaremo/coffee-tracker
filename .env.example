# Database
DATABASE_URL=file:./data/dev.db

# Better Auth (generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET=your-secret-here-min-32-chars-long
BETTER_AUTH_URL=http://localhost:3000

# MCP Server Token (generate with: openssl rand -hex 16)
MCP_TOKEN=your-mcp-bearer-token
MCP_PORT=3001

# Docker / Coolify routing (set BETTER_AUTH_URL to your public HTTPS app URL)
APP_DOMAIN=coffee.example.com
MCP_DOMAIN=mcp.coffee.example.com
