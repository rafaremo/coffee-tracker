    "db:studio": "prisma studio",
    "mcp": "tsx app/lib/mcp-server.ts",
    "mcp:http": "tsx app/lib/mcp-http-server.ts",
    "mcp:streamable": "tsx app/lib/mcp-streamable-server.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@remix-run/node": "^2.15.0",
    "@remix-run/react": "^2.15.0",
    "@remix-run/serve": "^2.15.0",
    "better-auth": "^1.7.7",
    "chart.js": "^4.4.7",
    "isbot": "^4.4.0",
    "lucide-react": "^1.51.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.15.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
