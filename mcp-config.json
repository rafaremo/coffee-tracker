{
  "mcpServers": {
    "coffee-tracker": {
      "command": "/absolute/path/to/node",
      "args": [
        "--import",
        "/absolute/path/to/coffee-tracker/node_modules/remix/dist/node-tsx.js",
        "/absolute/path/to/coffee-tracker/mcp-stdio.ts"
      ],
      "env": { "DATA_DIR": "/absolute/path/to/coffee-tracker/data" }
    }
  }
}
